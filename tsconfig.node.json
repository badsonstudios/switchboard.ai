{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    // #471: the main process translates its own strings now, so the shared
    // catalog (`src/shared/i18n/locales/*.json`) is imported from THIS project
    // too. `tsconfig.web.json` gets this for free — `moduleResolution: bundler`
    // turns it on by default — but `node`/`commonjs` resolution does not.
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/build/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/test-setup.ts",
    "src/test-fake-timers.test.ts"
  ]
}
