node_modules/
dist/
out/
*.log
.DS_Store
Thumbs.db

# Playwright e2e artifacts
test-results/
playwright-report/
.last-run.json

# Secrets & scratch — never committed (.env.example IS committed)
.claude/settings.local.json
.env
.env.*
!.env.example
.claude/.env
.claude/work_files/
!.claude/work_files/.gitkeep

# S-09 spike run artefacts (regenerated by the runners)
spike/s09/*.log

# S-11 probe 1 runtime files. The findings (summary + events) ARE committed
# when the run ends and the note is written; these two never are — a pid is
# meaningless to anyone else, and the stdout log is a duplicate of the events.
spike/findings/artifacts/s11/longrun.pid
spike/findings/artifacts/s11/longrun-stdout.log

# #760 bus probe run files. The measurements the findings note cites ARE
# committed (attach/direct/deadserver/toolcall JSON, the two server logs, and
# the config shape that worked) — a claim with a checkable artifact beside it is
# the whole point of the 721 convention. These are the generated inputs and the
# empty scratch dir: regenerated by the probes, meaningless on their own.
spike/probes/760/artifacts/scratch-cwd/
spike/probes/760/artifacts/silent-server.mjs
spike/probes/760/artifacts/dead-*.json
spike/probes/760/artifacts/deadturn-silent.json
spike/probes/760/artifacts/bus-config-toolcall.json
spike/probes/760/artifacts/bus-config-discovery.json
# …but the two server logs ARE the evidence for Q4/Q5 (argv and the config `env`
# block arriving verbatim), and the findings note quotes them by name. The
# blanket `*.log` above would have made that citation point at nothing.
!spike/probes/760/artifacts/server.log
!spike/probes/760/artifacts/server-toolcall.log
