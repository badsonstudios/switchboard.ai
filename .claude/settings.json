    "deny": [],
    "ask": [],
    "additionalDirectories": [
      "C:/Projects/Switchboard.ai",
      "C:/Projects/sb-wt-1",
      "C:/Projects/sb-wt-2",
      "C:/Projects/sb-wt-3",
      "C:/Projects/sb-wt-4",
      "C:/Projects/sb-wt-5",
      "C:/Projects/sb-wt-6",
      "C:/Projects/plans",
      "C:/tmp"
