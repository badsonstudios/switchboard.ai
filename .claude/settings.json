      "Bash(awk:*)",
      "Bash(perl:*)",
      "Bash(python:*)",
      "Bash(xargs:*)",
      "Bash(sleep:*)",
      "Bash(tee:*)",
      "PowerShell(git:*)",
      "PowerShell(gh:*)",
      "PowerShell(node:*)",
      "PowerShell(npm:*)",
      "PowerShell(npx:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Get-Process:*)",
      "PowerShell(Test-Path:*)"
